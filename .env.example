# Copy to .env.local (git-ignored) for `npm run dev`. Names only; never commit values.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>
# Server only (api/greeting.ts); set in Vercel, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# Optional: pin greeting links/QRs to one domain (production after G3 merges).
VITE_GREETING_BASE_URL=
