{
  "name": "webar-voice-sculpture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "test:int": "node --import ./tests/register.mjs --test --test-concurrency=1 tests/integration/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@vercel/functions": "2.2.13",
    "ffmpeg-static": "5.3.0",
    "qrcode": "1.5.4",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5",
    "@types/three": "0.185.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
